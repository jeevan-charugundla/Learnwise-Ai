APP_ENV=development
APP_NAME=LearnWise AI
API_PREFIX=/api
FRONTEND_ORIGIN=http://localhost:5173

# Supabase — leave blank to run in demo mode (SQLite, no auth required)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY is only needed for privileged server operations
SUPABASE_SERVICE_ROLE_KEY=

# Database — defaults to SQLite in demo mode.
# For Supabase Postgres: postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?sslmode=require
# URL-encode special characters in the password (e.g. [ -> %5B, ] -> %5D)
DATABASE_URL=sqlite:///./learnwise.db

# Groq (primary LLM) — both keys required together
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Legacy OpenAI-compatible LLM (fallback if Groq not configured)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Limits
LLM_TIMEOUT_SECONDS=45
MAX_QUESTIONS_PER_REQUEST=10
MAX_CSV_SIZE_MB=10
